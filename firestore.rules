rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get user role from users collection
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }
    
    // Helper function to check if user is editor
    function isEditor() {
      return isAuthenticated() && getUserRole() == 'editor';
    }
    
    // Helper function to check if user has access (admin or editor)
    function hasAccess() {
      return isAdmin() || isEditor();
    }
    
    // Users collection - authenticating users can read their own, admins can read/write all
    // Also allow users to create their own document (for migration) and delete their old one
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin() || resource.data.email == request.auth.token.email);
      allow create: if isAuthenticated() && (isAdmin() || request.auth.uid == userId);
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.email == request.auth.token.email);
    }
    
    // Publishers collection
    match /publishers/{publisherId} {
      allow read: if hasAccess();
      allow create, update, delete: if isAdmin();
    }
    
    // Emergency Contacts collection
    match /emergencyContacts/{contactId} {
      allow read: if hasAccess();
      allow create, update, delete: if hasAccess();
    }
    
    // Groups collection
    match /groups/{groupId} {
      allow read: if hasAccess();
      allow create, update, delete: if isAdmin();
    }
    
    // Reports collection
    match /reports/{reportId} {
      allow read: if hasAccess();
      allow create, update: if hasAccess(); // Both admin and editor can create/update reports (for deduplication)
      allow delete: if isAdmin();
    }
    
    // Meeting Attendance collection
    match /meetingAttendance/{attendanceId} {
      allow read: if hasAccess();
      allow create, update: if hasAccess();
      allow delete: if isAdmin();
    }
    
    // Logs collection
    match /logs/{logId} {
      allow read: if isAdmin();
      allow create: if hasAccess();
      allow update, delete: if isAdmin();
    }

    // Month Status collection
    match /monthStatus/{statusId} {
      allow read: if hasAccess();
      allow create, update, delete: if isAdmin();
    }
    
    // Schedules collection
    match /schedules/{scheduleId} {
      allow read: if hasAccess();
      allow create, update: if hasAccess(); // Both admin and editor can manage schedules
      allow delete: if isAdmin();
    }
    
    // Public Talks collection
    match /publicTalks/{talkId} {
      allow read: if hasAccess();
      allow create, update: if hasAccess();
      allow delete: if isAdmin();
    }
    
    // S-99 Master List collection
    match /s99_talks/{docId} {
      allow read: if hasAccess();
      allow create, update, delete: if isAdmin();
    }
    
    // Territories collection
    match /territories/{territoryId} {
      allow read: if hasAccess();
      allow create, update, delete: if hasAccess();
    }
    
    // Territory Assignments collection
    match /territoryAssignments/{assignmentId} {
      allow read: if hasAccess();
      allow create, update, delete: if hasAccess();
    }
    // Settings collection
    match /settings/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
